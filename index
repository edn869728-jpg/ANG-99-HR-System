<!DOCTYPE html>
<html lang="zh-Hant">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1.0,maximum-scale=1.0,user-scalable=no" />
  <title>ANG HR SYSTEMS｜ENTRY</title>
  <link rel="preload" as="image" href="https://pub-51476fa95e5148749c1b932e123dc797.r2.dev/ang-entry-bg-day.png?v=20260613-r2-html" referrerpolicy="no-referrer" />
  <link rel="preload" as="image" href="https://pub-51476fa95e5148749c1b932e123dc797.r2.dev/ang-entry-bg-night.png?v=20260613-r2-html" referrerpolicy="no-referrer" />
  <style>
    :root{
      --body-bg:#000000;
      --screen-bg:url("https://pub-51476fa95e5148749c1b932e123dc797.r2.dev/ang-entry-bg-day.png?v=20260613-r2-html");
      --screen-fallback:linear-gradient(180deg,#eef7ff 0%,#dff3ff 45%,#f3e7ff 100%);
      --panel-bg:rgba(255,255,255,.94);
      --panel-border:rgba(226,232,240,.92);
      --panel-shadow:0 -14px 34px rgba(15,23,42,.10);
      --main-text:#0f172a;
      --muted-text:#64748b;
      --soft-text:#94a3b8;
      --input-bg:#f1f5f9;
      --input-border:#e2e8f0;
      --primary-bg:linear-gradient(90deg,#00d9ff 0%,#7c3cff 58%,#b000ff 100%);
      --primary-text:#ffffff;
      --primary-shadow:0 8px 24px rgba(124,60,255,.26);
      --secondary-bg:#f8fafc;
      --secondary-text:#1e1b4b;
      --secondary-border:#c7d2fe;
      --card-bg:rgba(255,255,255,.94);
      --card-border:rgba(226,232,240,.92);
      --line:rgba(148,163,184,.24);
      --toggle-bg:rgba(255,255,255,.74);
      --toggle-border:rgba(148,163,184,.34);
      --toggle-shadow:0 10px 24px rgba(15,23,42,.12);
      --toggle-icon-dim:rgba(71,85,105,.72);
      --toggle-thumb-bg:#ffffff;
      --toggle-thumb-shadow:0 6px 14px rgba(15,23,42,.16);
      --toggle-thumb-x:0px;
      --ease:cubic-bezier(.22,1,.36,1);
    }

    body[data-theme="dark"]{
      --body-bg:#000000;
      --screen-bg:url("https://pub-51476fa95e5148749c1b932e123dc797.r2.dev/ang-entry-bg-night.png?v=20260613-r2-html");
      --screen-fallback:radial-gradient(circle at 50% 0%,#203b74 0%,#111a3b 42%,#050816 100%);
      --panel-bg:rgba(18,25,42,.88);
      --panel-border:rgba(255,255,255,.08);
      --panel-shadow:none;
      --main-text:#ffffff;
      --muted-text:#cbd5e1;
      --soft-text:#8b9bb4;
      --input-bg:rgba(255,255,255,.07);
      --input-border:rgba(255,255,255,.10);
      --secondary-bg:rgba(255,255,255,.06);
      --secondary-text:#ffffff;
      --secondary-border:rgba(255,255,255,.18);
      --card-bg:rgba(18,25,42,.88);
      --card-border:rgba(255,255,255,.08);
      --line:rgba(255,255,255,.10);
      --toggle-bg:rgba(15,23,42,.52);
      --toggle-border:rgba(255,255,255,.12);
      --toggle-shadow:0 10px 24px rgba(0,0,0,.28);
      --toggle-icon-dim:rgba(226,232,240,.68);
      --toggle-thumb-bg:rgba(255,255,255,.15);
      --toggle-thumb-shadow:0 0 18px rgba(0,217,255,.16);
      --toggle-thumb-x:28px;
    }

    *{box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
    html,body{margin:0;width:100%;height:100%;overflow:hidden;}
    body{
      display:flex;
      align-items:center;
      justify-content:center;
      background:var(--body-bg);
      font-family:"PingFang TC","Noto Sans TC","Microsoft JhengHei",sans-serif;
      color:var(--main-text);
      font-size:16px;
      letter-spacing:.02em;
      transition:background .25s ease;
    }
    button,input{font-family:inherit;}
    button{border:none;cursor:pointer;}

    .phone{
      width:100%;
      max-width:400px;
      height:min(100vh,760px);
      position:relative;
      overflow:hidden;
      border-radius:24px;
      background:var(--screen-fallback,#05060b);
      box-shadow:0 18px 42px rgba(0,0,0,.28);
    }
    .phone::before{
      content:"";
      position:absolute;
      inset:0;
      z-index:0;
      background:var(--screen-fallback);
      background-size:cover;
      background-position:center center;
      background-repeat:no-repeat;
      transition:background .25s ease;
    }
    .screen-bg-img{
      position:absolute;
      inset:0;
      z-index:1;
      width:100%;
      height:100%;
      object-fit:cover;
      object-position:center top;
      opacity:0;
      pointer-events:none;
      user-select:none;
      -webkit-user-drag:none;
      transform:translateZ(0);
      backface-visibility:hidden;
      transition:opacity .22s ease;
    }
    body:not([data-theme="dark"]) .screen-bg-img.bg-day{opacity:1;}
    body[data-theme="dark"] .screen-bg-img.bg-night{opacity:1;}
    .phone::after{
      content:"";
      position:absolute;
      inset:0;
      z-index:2;
      pointer-events:none;
      background:linear-gradient(180deg,rgba(0,0,0,0) 0%,rgba(0,0,0,.08) 66%,rgba(0,0,0,.18) 100%);
      opacity:.55;
    }
    body:not([data-theme="dark"]) .phone::after{
      background:linear-gradient(180deg,rgba(255,255,255,.04) 0%,rgba(255,255,255,.02) 62%,rgba(15,23,42,.08) 100%);
      opacity:.70;
    }

    .theme-toggle{
      position:absolute;
      top:14px;
      right:14px;
      width:58px;
      height:30px;
      padding:3px;
      border:1px solid var(--toggle-border);
      border-radius:999px;
      background:var(--toggle-bg);
      box-shadow:var(--toggle-shadow);
      backdrop-filter:blur(18px);
      -webkit-backdrop-filter:blur(18px);
      z-index:40;
      display:grid;
      grid-template-columns:1fr 1fr;
      align-items:center;
      justify-items:center;
      appearance:none;
      -webkit-appearance:none;
      overflow:hidden;
    }
    .theme-toggle::before{
      content:"";
      position:absolute;
      left:3px;
      top:3px;
      width:24px;
      height:24px;
      border-radius:50%;
      background:var(--toggle-thumb-bg);
      box-shadow:var(--toggle-thumb-shadow);
      transform:translateX(var(--toggle-thumb-x));
      transition:transform .25s ease,background .25s ease,box-shadow .25s ease;
    }
    .theme-toggle span{position:relative;z-index:1;width:24px;height:24px;display:flex;align-items:center;justify-content:center;color:var(--toggle-icon-dim);pointer-events:none;}
    .theme-toggle svg{width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2.1;stroke-linecap:round;stroke-linejoin:round;}
    body:not([data-theme="dark"]) .theme-toggle .sun{color:#0f172a;}
    body[data-theme="dark"] .theme-toggle .moon{color:#fff;filter:drop-shadow(0 0 5px rgba(255,255,255,.32));}

    .view{position:absolute;inset:0;z-index:5;display:none;flex-direction:column;}
    .view.active{display:flex;}
    .top-space{flex:1;min-height:360px;transition:opacity .42s var(--ease),transform .42s var(--ease);}
    .phone.expanded .top-space{opacity:.38;transform:translateY(-24px) scale(.96);}
    .panel{
      position:relative;
      z-index:8;
      margin-top:auto;
      min-height:264px;
      padding:28px 24px 24px;
      display:flex;
      flex-direction:column;
      background:var(--panel-bg);
      border-top:1px solid var(--panel-border);
      border-radius:28px 28px 0 0;
      box-shadow:var(--panel-shadow);
      backdrop-filter:blur(24px);
      -webkit-backdrop-filter:blur(24px);
      transition:background .25s ease,border-color .25s ease,box-shadow .25s ease;
    }
    .home-title{margin:0 0 18px;color:var(--main-text);text-align:center;font-size:26px;line-height:1.25;font-weight:1000;letter-spacing:.02em;transition:color .25s ease;}

    /* 按鈕統一：字體、間距、圖標、可讀性 */
    .btn{
      width:100%;
      min-height:56px;
      border:none;
      border-radius:16px;
      padding:15px 18px;
      font-size:18px;
      line-height:1.25;
      font-weight:1000;
      letter-spacing:.05em;
      cursor:pointer;
      text-align:center;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:10px;
      transition:transform .18s ease,background .25s ease,color .25s ease,border-color .25s ease,box-shadow .25s ease;
      text-shadow:0 1px 2px rgba(0,0,0,.18);
    }
    .btn:active{transform:scale(.98);}
    .btn-primary{margin-top:15px;background:var(--primary-bg);color:#fff!important;box-shadow:var(--primary-shadow);}
    .btn-secondary{
      background:linear-gradient(90deg,rgba(239,246,255,.96) 0%,rgba(245,243,255,.96) 100%)!important;
      color:#1e1b4b!important;
      border:1px solid rgba(99,102,241,.28)!important;
      box-shadow:0 10px 22px rgba(30,41,59,.10)!important;
      font-size:17px;
      letter-spacing:.04em;
      text-shadow:none!important;
    }
    body[data-theme="dark"] .btn-secondary{
      background:linear-gradient(90deg,rgba(59,130,246,.34) 0%,rgba(168,85,247,.30) 100%)!important;
      color:#ffffff!important;
      border:1px solid rgba(255,255,255,.20)!important;
      box-shadow:0 10px 24px rgba(0,0,0,.22)!important;
      text-shadow:0 1px 3px rgba(0,0,0,.45)!important;
    }
    .panel>.btn{min-height:58px;font-size:18px;}
    .btn-icon{width:1.35em;height:1.35em;flex:0 0 auto;display:inline-flex;align-items:center;justify-content:center;font-size:1.08em;line-height:1;transform:translateY(-.5px);opacity:1;}
    .btn-label{display:inline-block;min-width:0;white-space:normal;color:inherit!important;}

    .has-line-icon .btn-icon{
      min-width:34px;
      width:34px;
      height:22px;
      border-radius:7px;
      background:rgba(255,255,255,.96);
      color:#06c755;
      font-size:10px;
      font-family:Arial,sans-serif;
      font-weight:1000;
      letter-spacing:-.02em;
      box-shadow:0 3px 10px rgba(15,23,42,.12);
    }

    .has-google-icon .btn-icon{width:1.65em;height:1.65em;border-radius:999px;background:rgba(255,255,255,.95);color:#111827;font-family:Arial,sans-serif;font-size:.86em;font-weight:1000;box-shadow:0 3px 10px rgba(15,23,42,.12);}
    body[data-theme="dark"] .has-google-icon .btn-icon{background:rgba(255,255,255,.92);color:#111827;}

    .help-text{margin:10px 0 0;color:var(--muted-text);text-align:center;font-size:14px;line-height:1.5;font-weight:850;letter-spacing:.03em;transition:color .25s ease;}
    .spacer{flex:1;min-height:12px;}
    .entry-top-row{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:10px;}
    .section-title{margin:0;color:var(--main-text);font-size:28px;line-height:1.6;font-weight:1000;letter-spacing:.02em;transition:color .25s ease;}

    .back-btn,.contact-mini-btn{
      min-width:72px;
      height:38px;
      border:none;
      border-radius:999px;
      padding:6px 14px;
      font-size:15px;
      font-weight:1000;
      letter-spacing:.02em;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:6px;
      cursor:pointer;
      text-shadow:0 1px 2px rgba(0,0,0,.18);
    }
    body:not([data-theme="dark"]) .back-btn,
    body:not([data-theme="dark"]) .contact-mini-btn{background:#eef2ff!important;color:#312e81!important;border:1px solid rgba(99,102,241,.22)!important;text-shadow:none!important;}
    body[data-theme="dark"] .back-btn,
    body[data-theme="dark"] .contact-mini-btn{background:rgba(79,70,229,.36)!important;color:#ffffff!important;border:1px solid rgba(255,255,255,.16)!important;text-shadow:0 1px 3px rgba(0,0,0,.45)!important;}

    .field{margin:10px 0 12px;}
    .input-wrap{display:flex;align-items:center;min-height:54px;padding:4px 6px 4px 16px;border-radius:18px;background:var(--input-bg);border:1px solid var(--input-border);transition:background .25s ease,border-color .25s ease,box-shadow .2s ease;}
    .input-wrap:focus-within{border-color:rgba(124,60,255,.62);box-shadow:0 0 0 4px rgba(124,60,255,.13);}
    input{width:100%;border:none;outline:none;background:transparent;color:var(--main-text);font-size:18px;font-weight:1000;letter-spacing:.1em;padding:12px 0;text-transform:uppercase;}
    input::placeholder{color:var(--muted-text);opacity:.72;font-size:15px;font-weight:900;letter-spacing:.05em;text-transform:none;}
    .clear-btn{width:36px;height:36px;flex:0 0 auto;border:none;border-radius:14px;background:var(--secondary-bg);color:var(--secondary-text);font-size:20px;font-weight:1000;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;letter-spacing:0;}
    .btn-row{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:10px;}
    .btn-row .btn{min-height:50px;padding:12px 14px;font-size:16px;letter-spacing:.03em;gap:8px;border-radius:16px;}
    .hint{margin-top:14px;color:var(--muted-text);text-align:center;font-size:14px;line-height:1.5;font-weight:900;letter-spacing:.03em;transition:color .25s ease;}
    .status{display:none;margin-top:10px;padding:10px 12px;border-radius:15px;font-size:13px;line-height:1.45;font-weight:900;text-align:center;}
    .status.show{display:block;}
    .status.info{background:rgba(59,130,246,.14);color:#bfdbfe;border:1px solid rgba(59,130,246,.18);}
    .status.success{background:rgba(16,185,129,.14);color:#a7f3d0;border:1px solid rgba(16,185,129,.18);}
    .status.error{background:rgba(239,68,68,.14);color:#fecaca;border:1px solid rgba(239,68,68,.18);}
    body:not([data-theme="dark"]) .status.info{color:#2563eb;}
    body:not([data-theme="dark"]) .status.success{color:#059669;}
    body:not([data-theme="dark"]) .status.error{color:#dc2626;}
    .entry-mode{display:none;}
    .entry-mode.active{display:block;}

    .profile{display:flex;align-items:center;gap:12px;margin-bottom:12px;padding:12px;border-radius:18px;background:var(--input-bg);border:1px solid var(--input-border);}
    .avatar{width:44px;height:44px;flex:0 0 auto;display:flex;align-items:center;justify-content:center;border-radius:16px;background:var(--primary-bg);color:#fff;font-size:16px;font-weight:1000;}
    .profile-name{color:var(--main-text);font-size:18px;font-weight:1000;letter-spacing:.02em;}
    .profile-meta{margin-top:4px;color:var(--muted-text);font-size:13px;font-weight:850;letter-spacing:.03em;}

    .sheet-stage{position:absolute;left:0;right:0;bottom:0;z-index:8;height:190px;max-height:88vh;overflow:visible;transition:height .58s var(--ease);}
    .phone.expanded .sheet-stage{height:82vh;}
    .sheet-carousel{width:100%;height:100%;display:flex;gap:14px;overflow-x:auto;overflow-y:visible;scroll-snap-type:x mandatory;scroll-padding-left:calc((100% - 358px) / 2);scroll-padding-right:calc((100% - 358px) / 2);padding-left:calc((100% - 358px) / 2);padding-right:calc((100% - 358px) / 2);-webkit-overflow-scrolling:touch;touch-action:pan-x;overscroll-behavior-x:contain;overscroll-behavior-y:none;scroll-behavior:smooth;cursor:grab;scrollbar-width:none;}
    .sheet-carousel::-webkit-scrollbar{display:none;}
    .sheet-carousel.dragging{cursor:grabbing;scroll-snap-type:none;}
    .plan-sheet{flex:0 0 auto;height:100%;scroll-snap-align:center;border-radius:32px 32px 0 0;background:var(--card-bg);border:1px solid var(--card-border);border-bottom:0;box-shadow:0 -14px 34px rgba(15,23,42,.10);backdrop-filter:blur(26px);-webkit-backdrop-filter:blur(26px);overflow:hidden;display:flex;flex-direction:column;opacity:.58;transform:scale(.94) translateY(14px);transition:opacity .28s var(--ease),transform .28s var(--ease),box-shadow .28s var(--ease),background .28s ease;position:relative;touch-action:pan-x;}
    .plan-sheet.active{opacity:1;transform:scale(1) translateY(0);box-shadow:0 -18px 46px rgba(15,23,42,.15);}
    body[data-theme="dark"] .plan-sheet.active{box-shadow:0 -18px 46px rgba(0,0,0,.24);}
    .plan-sheet.login,.plan-sheet.basic,.plan-sheet.plus,.plan-sheet.premium{width:358px;}
    .plan-sheet::before{content:"";position:absolute;inset:0;background:radial-gradient(circle at 100% 0%,rgba(89,221,255,.18) 0%,rgba(89,221,255,0) 40%),radial-gradient(circle at 0% 100%,rgba(255,135,224,.13) 0%,rgba(255,135,224,0) 48%);pointer-events:none;z-index:0;}
    .sheet-handle-zone{width:100%;padding:12px 0 8px;display:flex;justify-content:center;flex:0 0 auto;cursor:default;position:relative;z-index:2;pointer-events:none;}
    .sheet-handle{width:44px;height:5px;border-radius:999px;background:rgba(100,116,139,.34);}
    body[data-theme="dark"] .sheet-handle{background:rgba(255,255,255,.20);}
    .sheet-summary{position:relative;z-index:2;padding:6px 32px 8px 16px;flex:0 0 auto;}
    .phone:not(.expanded) .sheet-stage::after{content:"往上滑開啟";position:absolute;left:50%;top:-24px;transform:translateX(-50%);display:block;color:var(--muted-text);font-size:15px;line-height:1.2;font-weight:900;letter-spacing:.06em;text-align:center;opacity:.78;animation:hintBounce 1.5s ease-in-out infinite;z-index:10;white-space:nowrap;pointer-events:none;}
    @keyframes hintBounce{0%,100%{transform:translateX(-50%) translateY(0);}50%{transform:translateX(-50%) translateY(-6px);}}

    .sheet-summary-grid{display:grid;grid-template-columns:1fr auto;grid-template-rows:auto auto;gap:16px 12px;align-items:end;justify-items:start;}
    .grid-title{grid-area:1/1/2/2;align-self:start;}.grid-tag{grid-area:1/2/2/3;align-self:start;justify-self:end;}.grid-pills{grid-area:2/1/3/2;}.grid-price{grid-area:2/2/3/3;justify-self:end;}
    .summary-main{display:flex;justify-content:space-between;align-items:center;gap:12px;}
    .sheet-title{margin:0;color:var(--main-text);font-size:36px;line-height:2;font-weight:1000;letter-spacing:-1px;text-shadow:0 1px 0 rgba(255,255,255,.12),0 0 1px rgba(255,255,255,.72),0 2px 14px rgba(0,0,0,.26);-webkit-text-stroke:.25px rgba(255,255,255,.22);}
    .plan-sheet.login .sheet-title{font-size:32px;letter-spacing:.02em;}
    .sheet-tag{display:inline-flex;padding:6px 12px;border-radius:999px;background:rgba(128,137,255,.18);color:#233876;font-size:12px;line-height:1;font-weight:1000;white-space:nowrap;border:1px solid rgba(128,137,255,.24);box-shadow:0 8px 18px rgba(128,137,255,.06);}
    .sheet-price{color:var(--main-text);font-size:30px;line-height:1;font-weight:1000;letter-spacing:-1px;display:flex;align-items:baseline;gap:4px;}
    .sheet-price span{color:var(--main-text);font-size:16px;font-weight:900;letter-spacing:0;}
    .mini-pills{display:flex;flex-wrap:nowrap;gap:8px;overflow-x:auto;-webkit-overflow-scrolling:touch;padding-bottom:6px;}
    .mini-pills::-webkit-scrollbar{display:none;}
    .mini-pill{flex:0 0 auto;padding:4px 10px;border-radius:999px;background:linear-gradient(90deg,rgba(128,137,255,0.14),rgba(236,72,153,0.04));border:1px solid rgba(128,137,255,0.24);color:#0f172a;font-size:11px;font-weight:800;letter-spacing:.4px;box-shadow:0 4px 12px rgba(124,60,255,0.05);transition:transform .18s ease,box-shadow .18s ease;line-height:1;}
    body[data-theme="dark"] .mini-pill{background:linear-gradient(90deg,rgba(255,255,255,0.04),rgba(255,255,255,0.02));border:1px solid rgba(255,255,255,0.12);color:#e5e7eb;box-shadow:0 10px 24px rgba(0,0,0,0.38);}
    .sheet-detail{position:relative;z-index:2;flex:1;min-height:0;overflow-y:auto;padding:0 20px 24px;opacity:0;transform:translateY(12px);pointer-events:none;transition:opacity .28s var(--ease),transform .28s var(--ease);scrollbar-width:none;}
    .sheet-detail::-webkit-scrollbar{display:none;}
    .phone.expanded .plan-sheet.active .sheet-detail{opacity:1;transform:translateY(0);pointer-events:auto;touch-action:pan-y;}
    .detail-block{margin-top:10px;padding-top:16px;border-top:1px solid var(--line);}
    .detail-title{margin:0 0 10px;color:var(--main-text);font-size:15px;font-weight:1000;}
    .note{margin-top:20px;color:var(--muted-text);font-size:13px;line-height:1.65;font-weight:800;border-top:1px solid var(--line);padding-top:16px;}

    .sheet-action{width:100%;margin-top:16px;padding-top:16px;border-top:1px solid var(--line);display:none;opacity:0;transform:translateY(10px);transition:opacity .24s var(--ease),transform .24s var(--ease),border-color .25s ease;}
    .phone.expanded .plan-sheet.active .sheet-action{display:block;opacity:1;transform:translateY(0);}
    .sheet-action button{width:100%;min-height:58px;border-radius:18px;background:var(--primary-bg);color:#fff!important;font-size:17px;line-height:1.28;font-weight:1000;letter-spacing:.03em;box-shadow:var(--primary-shadow);padding:14px 18px;display:flex;align-items:center;justify-content:center;gap:10px;text-shadow:0 1px 2px rgba(0,0,0,.18);}
    .sheet-action .outline-action{margin-top:10px;background:var(--secondary-bg);color:var(--secondary-text);border:1px solid var(--secondary-border);box-shadow:none;font-size:16px!important;}
    .google-action{margin-top:10px;background:#ffffff!important;color:#111827!important;border:1px solid rgba(148,163,184,.42)!important;box-shadow:none!important;text-shadow:none!important;font-size:16px!important;}
    body[data-theme="dark"] .google-action{background:rgba(255,255,255,.92)!important;color:#111827!important;border:1px solid rgba(255,255,255,.35)!important;text-shadow:none!important;}
