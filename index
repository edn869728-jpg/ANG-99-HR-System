        called = callNativeThemeMethod(bridge,'switchThemeAssets',payload) || called;
        called = callNativeThemeMethod(bridge,'changeThemeAssets',payload) || called;
        called = callNativeThemeMethod(bridge,'setDayNightAssets',payload) || called;
        called = callNativeThemeMethod(bridge,'switchDayNightAssets',payload) || called;
