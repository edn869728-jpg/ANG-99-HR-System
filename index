<script>
(function(){
  const V28_GAS_ACTIONS = {
    requestEmailCode:'requestEmailCode',
    verifyEmailCode:'verifyEmailCode',
    registerCompany:'registerCompany',
    verifyAdminEmailCodeAndLogin:'verifyAdminEmailCodeAndLogin',
    activateEmployeeByVerifiedAuth:'activateEmployeeByVerifiedAuth',
    employeeQuickLoginByCompanyCode:'employeeQuickLoginByCompanyCode',
    verifyEmployeeSession:'verifyEmployeeSession'
  };
  const V28_EMAIL_LIMIT=5, V28_RESEND_SECONDS=60;
  const v28State={reg:{plan:'',email:'',method:'email',verifyToken:''},admin:{company:'',email:'',method:'email',verifyToken:''},emp:{company:'',employeeId:'',code:'',verifyToken:''}};
  function q(id){return document.getElementById(id)}
  function text(id,v){const el=q(id);if(el)el.innerText=v||''}
  function val(id){const el=q(id);return String(el&&el.value||'').trim()}
  function setVal(id,v){const el=q(id);if(el)el.value=v||''}
  function showStatus(id,type,msg){const el=q(id);if(!el)return;el.className='ang-v28-status';if(!msg){el.innerText='';return}el.classList.add('show',type||'info');el.innerText=msg}
  function emailOk(s){return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(String(s||'').trim())}
  function dayKey(){return new Date().toISOString().slice(0,10)}
  function flowKey(flow,email,company){return 'ang_v28_email_'+flow+'_'+String(company||'')+'_'+String(email||'').toLowerCase()+'_'+dayKey()}
  function cooldownKey(flow,email,company){return 'ang_v28_cooldown_'+flow+'_'+String(company||'')+'_'+String(email||'').toLowerCase()}
  function readCount(flow,email,company){return Number(localStorage.getItem(flowKey(flow,email,company))||0)}
  function incCount(flow,email,company){const k=flowKey(flow,email,company);const n=readCount(flow,email,company)+1;localStorage.setItem(k,String(n));return n}
  function cooldownLeft(flow,email,company){const t=Number(localStorage.getItem(cooldownKey(flow,email,company))||0);return Math.max(0,Math.ceil((V28_RESEND_SECONDS*1000-(Date.now()-t))/1000))}
  function markCooldown(flow,email,company){localStorage.setItem(cooldownKey(flow,email,company),String(Date.now()))}
  function updateBtn(btnId,flow,email,company){const b=q(btnId);if(!b)return;const left=cooldownLeft(flow,email,company);const count=readCount(flow,email,company);if(count>=V28_EMAIL_LIMIT){b.disabled=true;b.innerText='今日已達 5 次上限';return}if(left>0){b.disabled=true;b.innerText='請等待 '+left+' 秒';return}b.disabled=false;b.innerText='重新發送驗證碼（今日 '+count+'/'+V28_EMAIL_LIMIT+'）'}
  setInterval(function(){updateBtn('v28RegResendBtn','company_signup',v28State.reg.email,'');updateBtn('v28AdminResendBtn','admin_login',v28State.admin.email,v28State.admin.company);updateBtn('v28EmpResendBtn','employee_activate',val('v28EmpEmail'),v28State.emp.company)},1000);
  function gasRun(action,payload){
    payload=Object.assign({},payload||{},{action:action,device_id:(APP_STATE&&APP_STATE.deviceId)||localStorage.getItem('ang_device_id')||''});
    return new Promise(function(resolve,reject){
      if(window.google&&google.script&&google.script.run){
        google.script.run.withSuccessHandler(resolve).withFailureHandler(reject)[action](payload);return;
      }
      if(typeof callGasApi==='function'){callGasApi(action,payload,25000).then(resolve).catch(reject);return;}
      reject(new Error('找不到 GAS 連線'));
    });
  }
  function setOnlyView(id){['homeView','employeeEntryView','managerEntryView','v28RegisterFlow','v28AdminEmailFlow','v28EmployeeVerifyFlow'].forEach(function(x){const el=q(x);if(el){el.classList.remove('active');el.style.display='none';el.setAttribute('aria-hidden','true')}});const t=q(id);if(t){t.classList.add('active');t.style.display='flex';t.setAttribute('aria-hidden','false')}}
  window.v28BackToManager=function(){if(typeof setView==='function')setView('managerEntryView');else setOnlyView('managerEntryView')}
  function showRegister(plan,email,method,name){v28State.reg={plan:plan,email:email,method:method||'email',verifyToken:''};text('v28RegPlan','方案：'+String(plan||'').toUpperCase());text('v28RegMethod','註冊方式：'+(method||'Email'));setVal('v28RegEmail',email||'');setVal('v28RegAccountName',name||'');showStatus('v28RegStatus','','');setOnlyView('v28RegisterFlow');updateBtn('v28RegResendBtn','company_signup',email,'')}
  function showAdmin(company,email,method,name){v28State.admin={company:company,email:email,method:method||'email',verifyToken:''};text('v28AdminCompany','公司：'+company);text('v28AdminMethod','登入方式：'+(method||'Email'));setVal('v28AdminEmail',email||'');setVal('v28AdminName',name||'');showStatus('v28AdminStatus','','');setOnlyView('v28AdminEmailFlow');updateBtn('v28AdminResendBtn','admin_login',email,company)}
  function showEmployeeActivate(company,employeeId,code){v28State.emp={company:company,employeeId:employeeId,code:code,verifyToken:''};text('v28EmpCompany','公司：'+company);text('v28EmpIdPill','員工：'+employeeId);showStatus('v28EmpStatus','','');setOnlyView('v28EmployeeVerifyFlow');}
  function sendCode(flow,email,company,plan,statusId){if(!emailOk(email)){showStatus(statusId,'error','請輸入正確 Email');return Promise.reject(new Error('bad email'))}if(readCount(flow,email,company)>=V28_EMAIL_LIMIT){showStatus(statusId,'error','今天此信箱已發送 5 次');return Promise.reject(new Error('daily limit'))}let left=cooldownLeft(flow,email,company);if(left>0){showStatus(statusId,'error','請等待 '+left+' 秒後再重寄');return Promise.reject(new Error('cooldown'))}showStatus(statusId,'info','正在寄送驗證碼...');return gasRun(V28_GAS_ACTIONS.requestEmailCode,{flow:flow,email:email,company_id:company||'',plan:plan||''}).then(function(res){if(!res||!res.ok)throw new Error(res&&res.message||'寄送失敗');incCount(flow,email,company);markCooldown(flow,email,company);showStatus(statusId,'success',res.message||'驗證碼已寄出');return res}).catch(function(e){showStatus(statusId,'error',e.message||String(e));throw e})}
  window.requestPlanEmailVerification=function(plan){const p=String(plan||'').toLowerCase();const email=val(p+'SignupEmail');if(!emailOk(email)){setStatus(p+'PlanStatus','error','請輸入正確 Email');return}sendCode('company_signup',email,'',p,p+'PlanStatus').then(function(){showRegister(p,email,'Email','')}).catch(function(){})}
  window.v28ResendRegisterCode=function(){sendCode('company_signup',val('v28RegEmail'),'',v28State.reg.plan,'v28RegStatus').catch(function(){})}
  window.v28VerifyRegisterCode=function(){const email=val('v28RegEmail'),code=val('v28RegCode');showStatus('v28RegStatus','info','驗證中...');gasRun(V28_GAS_ACTIONS.verifyEmailCode,{flow:'company_signup',email:email,code:code,plan:v28State.reg.plan}).then(function(res){if(!res||!res.ok)throw new Error(res&&res.message||'驗證失敗');v28State.reg.verifyToken=res.verify_token;showStatus('v28RegStatus','success','驗證成功，請填公司資料')}).catch(function(e){showStatus('v28RegStatus','error',e.message||String(e))})}
  window.v28CreateCompany=function(){if(!v28State.reg.verifyToken){showStatus('v28CompanyStatus','error','請先完成 Email 驗證');return}const companyName=val('v28CompanyName'),adminName=val('v28RegAccountName'),adminPhone=val('v28AdminPhone');if(!companyName||!adminName||!adminPhone){showStatus('v28CompanyStatus','error','請填公司名稱、帳號名稱、手機');return}showStatus('v28CompanyStatus','info','建立公司中...');gasRun(V28_GAS_ACTIONS.registerCompany,{verify_token:v28State.reg.verifyToken,plan:v28State.reg.plan,company_name:companyName,admin_name:adminName,admin_phone:adminPhone,birth_date:val('v28BirthDate'),email:val('v28RegEmail')}).then(function(res){if(!res||!res.ok)throw new Error(res&&res.message||'建立失敗');showStatus('v28CompanyStatus','success','建立完成，正在進入後台');const url=res.admin_url||res.next_url||('admin.html?company_id='+encodeURIComponent(res.company_id||'')+'&id='+encodeURIComponent(res.creator_employee_id||'ANG8963')+'&token='+encodeURIComponent(res.session_token||''));setTimeout(function(){location.href=url},500)}).catch(function(e){showStatus('v28CompanyStatus','error',e.message||String(e))})}
  window.requestAdminEmailLogin=function(){const company=normalizeCompanyCode(q('adminCompanyCode')?q('adminCompanyCode').value:'');const email=val('adminEmail');if(!company){setStatus('adminLoginStatus','error','請輸入公司代碼');return}if(!emailOk(email)){setStatus('adminLoginStatus','error','請輸入正確 Email');return}sendCode('admin_login',email,company,'','adminLoginStatus').then(function(){showAdmin(company,email,'Email','')}).catch(function(){})}
  window.v28ResendAdminCode=function(){sendCode('admin_login',val('v28AdminEmail'),v28State.admin.company,'','v28AdminStatus').catch(function(){})}
  window.v28VerifyAdminCodeAndLogin=function(){showStatus('v28AdminStatus','info','驗證並登入中...');gasRun(V28_GAS_ACTIONS.verifyAdminEmailCodeAndLogin,{company_id:v28State.admin.company,email:val('v28AdminEmail'),code:val('v28AdminCode'),admin_name:val('v28AdminName')}).then(function(res){if(!res||!res.ok)throw new Error(res&&res.message||'登入失敗');showStatus('v28AdminStatus','success','驗證成功，正在進入後台');setTimeout(function(){location.href=res.next_url||res.nextUrl||('admin.html?company_id='+encodeURIComponent(v28State.admin.company)+'&id='+encodeURIComponent(val('v28AdminEmail'))+'&role=Admin&verified=1')},350)}).catch(function(e){showStatus('v28AdminStatus','error',e.message||String(e))})}
  const oldNativeReceiver=window.ANG_NATIVE_GAS_RESULT_RECEIVER;
  window.ANG_NATIVE_GAS_RESULT_RECEIVER=function(payload){try{const gasRes=payload&& (payload.gas_response||payload.gasResponse||payload);const pending=loadPendingNativeAuth&&loadPendingNativeAuth();if(gasRes&&gasRes.ok&&pending&&pending.flow==='admin_login'){const company=pending.company||pending.company_id||'';const email=gasRes.email||'';const name=gasRes.profile_name||'';location.href='admin.html?company_id='+encodeURIComponent(company)+'&id='+encodeURIComponent(email||'verified')+'&role=Admin&verified=1&auth_provider='+encodeURIComponent(gasRes.provider||pending.provider||'')+'&auth_email='+encodeURIComponent(email)+'&name='+encodeURIComponent(name)+'&token='+encodeURIComponent(gasRes.verify_token||'');return}if(gasRes&&gasRes.ok&&pending&&pending.flow==='employee_activate'){v28State.emp.verifyToken=gasRes.verify_token||'';v28FinishEmployeeActivation();return}}catch(e){}if(typeof oldNativeReceiver==='function')oldNativeReceiver(payload)};
  window.submitActivationCode=function(){const raw=val('activationCode').toUpperCase();if(!raw){setStatus('codeStatus','error','請輸入開通碼或公司代碼');return}const savedId=localStorage.getItem('ang_employee_id')||'';const savedToken=localStorage.getItem('ang_employee_token')||localStorage.getItem('emp_login_token')||'';const device=(APP_STATE&&APP_STATE.deviceId)||localStorage.getItem('ang_device_id')||'';if(savedId&&savedToken&&!/^ACT/i.test(raw)&&raw.length<=12){setStatus('codeStatus','info','正在用此手機既有授權登入...');gasRun(V28_GAS_ACTIONS.employeeQuickLoginByCompanyCode,{company_id:raw,id:savedId,employee_id:savedId,token:savedToken,session_token:savedToken,device_id:device}).then(function(res){if(!res||!res.ok)throw new Error(res&&res.message||'登入失敗');handleBindSuccess({id:res.employee_id||savedId,name:res.name||'',token:res.session_token||savedToken,loginToken:res.session_token||savedToken,company_id:res.company_id||raw});}).catch(function(e){setStatus('codeStatus','error',e.message||String(e))});return}const parts=raw.split(/[-\s]/).filter(Boolean);const company=parts.length>=3?parts[0]:prompt('請輸入公司代碼');const empId=parts.length>=3?parts[1]:prompt('請輸入員工編號');const code=parts.length>=3?parts.slice(2).join(''):raw;if(!company||!empId||!code){setStatus('codeStatus','error','請輸入公司代碼、員工編號與開通碼');return}showEmployeeActivate(company.toUpperCase(),empId.toUpperCase(),code)};
  window.v28SendEmployeeEmailCode=function(){sendCode('employee_activate',val('v28EmpEmail'),v28State.emp.company,'','v28EmpStatus').catch(function(){})}
  window.v28VerifyEmployeeEmailThenActivate=function(){const email=val('v28EmpEmail'),code=val('v28EmpCode');showStatus('v28EmpStatus','info','驗證中...');gasRun(V28_GAS_ACTIONS.verifyEmailCode,{flow:'employee_activate',email:email,code:code,company_id:v28State.emp.company}).then(function(res){if(!res||!res.ok)throw new Error(res&&res.message||'驗證失敗');v28State.emp.verifyToken=res.verify_token;v28FinishEmployeeActivation()}).catch(function(e){showStatus('v28EmpStatus','error',e.message||String(e))})}
  window.v28EmployeeNativeAuth=function(provider){const phone=val('v28EmpPhone');if(!phone){showStatus('v28EmpStatus','error','請先填手機號碼');return}if(typeof callAndroidNativeAuth==='function'){callAndroidNativeAuth(provider,'employee_activate','',{company:v28State.emp.company,company_id:v28State.emp.company,employee_id:v28State.emp.employeeId,activation_code:v28State.emp.code,phone:phone,source:'employee_activate'},'v28EmpStatus');return}showStatus('v28EmpStatus','error','目前沒有 App 原生橋接，請使用 Email 驗證')}
  function v28FinishEmployeeActivation(){const phone=val('v28EmpPhone');if(!phone){showStatus('v28EmpStatus','error','請填手機號碼');return}if(!v28State.emp.verifyToken){showStatus('v28EmpStatus','error','請先完成任一驗證');return}showStatus('v28EmpStatus','info','正在開通此手機...');gasRun(V28_GAS_ACTIONS.activateEmployeeByVerifiedAuth,{company_id:v28State.emp.company,employee_id:v28State.emp.employeeId,activation_code:v28State.emp.code,one_time_token:v28State.emp.code,phone:phone,verify_token:v28State.emp.verifyToken,device_id:(APP_STATE&&APP_STATE.deviceId)||localStorage.getItem('ang_device_id')||''}).then(function(res){if(!res||!res.ok)throw new Error(res&&res.message||'開通失敗');localStorage.setItem('ang_company_id',res.company_id||v28State.emp.company);localStorage.setItem('ang_employee_id',res.employee_id||v28State.emp.employeeId);localStorage.setItem('ang_employee_token',res.session_token||res.token||'');localStorage.setItem('ang_employee_name',res.name||'');localStorage.removeItem('ang_employee_manual_logout');handleBindSuccess({id:res.employee_id||v28State.emp.employeeId,name:res.name||'',token:res.session_token||res.token||'',loginToken:res.session_token||res.token||'',company_id:res.company_id||v28State.emp.company})}).catch(function(e){showStatus('v28EmpStatus','error',e.message||String(e))})}
  const oldHandleBindSuccess=window.handleBindSuccess;
  window.handleBindSuccess=function(res){res=res||{};const id=String(res.id||res.employee_id||res.employeeId||res.empId||APP_STATE.id||'').trim().toUpperCase();const token=String(res.loginToken||res.session_token||res.token||'').trim();const name=String(res.name||res.employeeName||APP_STATE.name||id||'員工').trim();if(id)localStorage.setItem('ang_employee_id',id);if(token)localStorage.setItem('ang_employee_token',token);if(name)localStorage.setItem('ang_employee_name',name);if(res.company_id)localStorage.setItem('ang_company_id',res.company_id);localStorage.setItem('emp_logged_in',id);localStorage.setItem('emp_login_token',token);localStorage.setItem('isLoggedIn','1');localStorage.removeItem('ang_employee_manual_logout');let url='employee.html?id='+encodeURIComponent(id)+'&token='+encodeURIComponent(token);if(res.company_id)url+='&company_id='+encodeURIComponent(res.company_id);window.location.href=url};
  function tryAutoEmployeeLogin(){try{if(localStorage.getItem('ang_employee_manual_logout')==='1')return;const id=localStorage.getItem('ang_employee_id')||'';const token=localStorage.getItem('ang_employee_token')||localStorage.getItem('emp_login_token')||'';const company=localStorage.getItem('ang_company_id')||'';if(id&&token&&company&&location.search.indexOf('no_auto=1')<0){gasRun(V28_GAS_ACTIONS.verifyEmployeeSession,{company_id:company,id:id,employee_id:id,token:token,session_token:token,device_id:(APP_STATE&&APP_STATE.deviceId)||localStorage.getItem('ang_device_id')||''}).then(function(res){if(res&&res.ok){location.href='employee.html?company_id='+encodeURIComponent(company)+'&id='+encodeURIComponent(id)+'&token='+encodeURIComponent(token)}}).catch(function(){})}}catch(e){}}
  const oldInit=window.init;window.init=function(){if(typeof oldInit==='function')oldInit();setTimeout(tryAutoEmployeeLogin,700)};
})();
