    function sendCapturedNativeAuthToGas(result){
      const r = normalizeNativeResult(result || window.__ANG_LAST_NATIVE_AUTH_RESULT || {});
      const pending = loadPendingNativeAuth() || {};
      const statusId = getPendingNativeStatusId(pending);
      const provider = r.provider || pending.provider || '';
      const token = r.id_token || '';
      const key = provider + ':' + token;
      const now = Date.now();

      if (!provider || !token) {
        setStatus(statusId,'error','沒有可送出的 provider 或 token');
        return;
      }
      if (window.__ANG_NATIVE_GAS_SENT_KEY === key && (now - (window.__ANG_NATIVE_GAS_SENT_AT || 0)) < 15000) {
        setStatus(statusId,'info','同一筆資料 15 秒內已送過 GAS，不重複送出。');
        return;
      }

      window.__ANG_NATIVE_GAS_SENT_KEY = key;
      window.__ANG_NATIVE_GAS_SENT_AT = now;

      const action = provider === 'line' ? 'verifyNativeLineIdToken' : 'verifyNativeGoogleIdToken';
      const payload = Object.assign({},pending || {},{
        action:action,
        provider:provider,
        flow:pending.flow || 'company_signup',
