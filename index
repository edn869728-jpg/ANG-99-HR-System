    /* ANG_INDEX_V21_FEATURES_GLASS_FIX
       保留原本流程，只補方案特色與卡片玻璃感。 */
    .plan-sheet{
      background:rgba(255,255,255,.16)!important;
      border-color:rgba(255,255,255,.24)!important;
      backdrop-filter:blur(30px) saturate(1.18)!important;
      -webkit-backdrop-filter:blur(30px) saturate(1.18)!important;
    }
    body[data-theme="dark"] .plan-sheet{
      background:rgba(12,18,34,.56)!important;
      border-color:rgba(255,255,255,.12)!important;
    }
    .plan-sheet:not(.active){
      opacity:.44;
      filter:saturate(.82) brightness(.84);
    }
    .plan-sheet.active{
      opacity:1;
      filter:none;
    }
    .feature-card{
      background:rgba(255,255,255,.13)!important;
      backdrop-filter:blur(18px)!important;
      -webkit-backdrop-filter:blur(18px)!important;
    }
    body[data-theme="dark"] .feature-card{
      background:rgba(255,255,255,.065)!important;
