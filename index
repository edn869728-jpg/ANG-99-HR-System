    /* ANG_THEME_ASSET_SYNC_V22
       日光 / 暗夜切換時，詢問是否連同 APP 圖示與開場動畫一起更換。 */
    .theme-sync-modal{
      position:absolute;
      inset:0;
      z-index:999;
      display:none;
      align-items:center;
      justify-content:center;
      padding:22px;
