    function callGasApi(action,payload,timeoutMs){
      const gasUrl = getGasApiUrl();
      if (!gasUrl) return Promise.reject(new Error('尚未設定 GAS API URL'));
      return new Promise(function(resolve,reject){
        const callbackName = 'angGasJsonp_' + Date.now().toString(36) + '_' + Math.random().toString(36).slice(2,8);
        const script = document.createElement('script');
        let done = false;
        function cleanup(){
          try { delete window[callbackName]; } catch(err) { window[callbackName] = undefined; }
          if (script && script.parentNode) script.parentNode.removeChild(script);
        }
        const timer = setTimeout(function(){
          if (done) return;
          done = true;
          cleanup();
          reject(new Error('GAS 連線逾時'));
        },timeoutMs || 25000);
        window[callbackName] = function(res){
          if (done) return;
          done = true;
          clearTimeout(timer);
          cleanup();
          resolve(res || {});
        };
        script.onerror = function(){
          if (done) return;
          done = true;
          clearTimeout(timer);
          cleanup();
          reject(new Error('無法連線 GAS API'));
        };
        const url = new URL(gasUrl,window.location.href);
        const body = Object.assign({},payload || {},{ action:action });
        url.searchParams.set('action',action);
        url.searchParams.set('callback',callbackName);
        url.searchParams.set('payload',JSON.stringify(body));
        script.src = url.toString();
        document.head.appendChild(script);
      });
